#!/usr/bin/env sh
# check — 项目唯一校验入口。单命令跑通全部校验：
#   0) data      (scripts/build-data.mjs --verify -> 数据契约 schema 校验 + 漂移比对)
#   1) lint      (next lint)
#   2) typecheck (tsc --noEmit)
#   3) build     (next build -> 静态导出 out/)
# 任一步失败即以非零码退出。后续所有任务的验收都通过本脚本。
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$ROOT_DIR"

# 依赖缺失时给出明确指引（应先运行 scripts/bootstrap）。
if [ ! -d node_modules ]; then
  echo "[check] ERROR: node_modules missing. Run scripts/bootstrap first." >&2
  exit 1
fi

# 构建期数据契约校验（T1 AIO-28）：逐条 schema 校验 + 与已提交 dataset.json 漂移比对。
# 字段缺失走降级（生成侧规则），不可降级的坏记录或漂移即失败。
echo "[check] 0/3 data contract (schema + drift)"
node scripts/build-data.mjs --verify

echo "[check] 1/3 lint"
npm run lint

echo "[check] 2/3 typecheck"
npm run typecheck

echo "[check] 3/3 build (static export)"
npm run build

echo "[check] all checks passed."
