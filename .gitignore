# dependencies
/node_modules
/.pnp
.pnp.js

# next.js / build output
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# 内容清洗流水线相关（AIO · content-pipeline）
# ---------------------------------------------------------------------------

# 原始媒体（大文件，永不入库；来源事实由 data/catalog.json 记录）
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.flac

# yt-dlp 原始下载输出目录（媒体 + info.json + 缩略图）
/data/ai_engineer_first_100/
/data/cursor_compile_2026/
/data/figma_config_2026/

# 下载 / 抓取日志
/data/*.log

# 清洗后数据 / 转录文本：不入库，后续进数据库（仅保留 README 与源 catalog）。
# 站点消费的 dataset.json 提交「纯 catalog 基线」；enrichments 在部署时从 DB 合并。
/data/enrichments/*.json
/data/editorial/*.json
/tests/*.json
/tests/*.txt
/tests/*.srt
/tests/*.vtt

# Paperclip 临时产物（请求、日志、临时脚本）
/.pc_tmp/

# mockup 渲染用的浏览器 CDP profile
/design/mockups/_cdp_profile/

# 流水线运行时产物（中间件、工作区、日志 —— 全部本地，不入库）
/pipeline/artifacts/
/pipeline/work/
/pipeline/logs/
/local-data/

# Python（流水线为纯 stdlib，无 venv；仅忽略字节码缓存）
__pycache__/
*.py[cod]
/pipeline/.venv/

# API keys / 本地环境
.env
.env.local
