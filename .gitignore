# dependencies
/node_modules
/.pnp
.pnp.js

# next.js / build output
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# 内容清洗流水线相关（AIO · content-pipeline）
# ---------------------------------------------------------------------------

# 原始媒体（大文件，永不入库；来源事实由 data/catalog.json 记录）
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.flac

# yt-dlp 原始下载输出目录（媒体 + info.json + 缩略图）
/data/ai_engineer_first_100/
/data/cursor_compile_2026/
/data/figma_config_2026/

# 下载 / 抓取日志
/data/*.log

# 清洗后数据 / 转录文本：不入库，全部走数据库（见 deploy/seed.sql）。
/data/enrichments/*.json
/data/editorial/*.json
/data/digests/*.json
/tests/*.json
/tests/*.txt
/tests/*.srt
/tests/*.vtt

# 站点数据集：构建产物，由 scripts/build-data.mjs 从数据源生成（DATA_SOURCE=file|api），
# 不入库。CI/部署在 build 前执行 `node scripts/build-data.mjs`。
/src/data/dataset.json
/src/data/dataset.en.json

# 英文渲染产物：与 enrichments 同为清洗产物，不入库（由流水线 i18n_en 阶段再生）
/data/i18n/

# yt-dlp 原始抓取 dump：冗余（data/catalog.json 是合并后的 canonical 源，
# build 只读它；dump 可用已提交的 download_*.py 重跑）。
/data/ai_engineer_channel.json
/data/figma_config_2026.json
/data/cursor_compile_2026.json
/data/catalog.csv


# Paperclip 临时产物（请求、日志、临时脚本）
/.pc_tmp/

# mockup 渲染用的浏览器 CDP profile
/design/mockups/_cdp_profile/

# 流水线运行时产物（中间件、工作区、日志 —— 全部本地，不入库）
/pipeline/artifacts/
/pipeline/work/
/pipeline/logs/
/local-data/

# Python（流水线为纯 stdlib，无 venv；仅忽略字节码缓存）
__pycache__/
*.py[cod]
/pipeline/.venv/

# API keys / 本地环境
.env
.env.local

# 部署用 SQL：由 scripts/export-sql.mjs 从数据源再生，不入库
/deploy/*.sql

# 关键画面：清洗产物、二进制，不入 git；生产走 R2（见 deploy/R2-frames.md）。
# 本地仍由流水线写入 public/frames/ 供开发预览与上传，仅不进版本库。
/public/frames/
