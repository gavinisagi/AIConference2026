# ---------------------------------------------------------------------------
# 内容清洗流水线相关（AIO · content-pipeline）
# ---------------------------------------------------------------------------

# 原始媒体（大文件，永不入库；来源事实由 data/catalog.json 记录）
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.flac

# yt-dlp 原始下载输出目录（媒体 + info.json + 缩略图）
/data/ai_engineer_first_100/
/data/cursor_compile_2026/
/data/figma_config_2026/

# 下载 / 抓取日志
/data/*.log

# 转录文本：不入库（原始语料，后续进数据库）。
/tests/*.json
/tests/*.txt
/tests/*.srt
/tests/*.vtt

# 注：本演示分支 feat/compile-tour-populated 刻意提交 data/enrichments/*.json 与
# 已合并 tour 的 dataset.json，用于呈现「有清洗数据后网站的整体感觉」。
# 数据入库(DB + CRUD)后应恢复 PR#1 的边界：忽略 enrichments、dataset 回退基线。

# Paperclip 临时产物（请求、日志、临时脚本）
/.pc_tmp/

# mockup 渲染用的浏览器 CDP profile
/design/mockups/_cdp_profile/

# 流水线运行时产物（中间件、工作区、日志 —— 全部本地，不入库）
/pipeline/artifacts/
/pipeline/work/
/pipeline/logs/
/local-data/

# Python（流水线为纯 stdlib，无 venv；仅忽略字节码缓存）
__pycache__/
*.py[cod]
/pipeline/.venv/

# API keys / 本地环境
.env
.env.local

# 部署用 SQL：由 scripts/export-sql.mjs 从数据源再生，不入库
/deploy/*.sql
